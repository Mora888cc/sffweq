--=============================================================
-- config persistence
--=============================================================
local CFG_DIR = "penablox_recode"
local CFG_FILE = CFG_DIR .. "/config.json"

local function ensureFolder()
	if type(isfolder_) == "function" and type(makefolder_) == "function" then
		local ok, exists = pcall(isfolder_, CFG_DIR)
		if ok and not exists then
			pcall(makefolder_, CFG_DIR)
		end
	end
end

local function saveConfig()
	if type(writefile_) ~= "function" then
		return false, "no filesystem"
	end
	ensureFolder()
	local payload = {}
	for key, value in pairs(Flags) do
		if type(value) == "boolean" or type(value) == "number" or type(value) == "string" then
			payload[key] = value
		end
	end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode({ flags = payload })
	end)
	if not ok then
		return false, "encode failed"
	end
	local wrote = pcall(writefile_, CFG_FILE, encoded)
	if not wrote then
		return false, "write failed"
	end
	return true
end

local function loadConfig()
	if type(readfile_) ~= "function" or type(isfile_) ~= "function" then
		return false, "no filesystem"
	end
	local ok, exists = pcall(isfile_, CFG_FILE)
	if not ok or not exists then
		return false, "no config"
	end
	local raw = try(readfile_, CFG_FILE)
	if type(raw) ~= "string" or raw == "" then
		return false, "empty"
	end
	local decoded = try(function()
		return HttpService:JSONDecode(raw)
	end)
	if type(decoded) ~= "table" or type(decoded.flags) ~= "table" then
		return false, "bad json"
	end
	for key, value in pairs(decoded.flags) do
		if Flags[key] ~= nil or key == "aimKey" then
			Flags[key] = value
		end
	end
	for _, ctrl in pairs(UI.controls) do
		if ctrl.render then
			pcall(ctrl.render)
		end
	end
	-- side-effecting flags need their hook state restored too
	if Flags.nospread then
		NoSpread.enable()
	else
		NoSpread.disable()
	end
	InfAmmo.enabled = Flags.infammo
	Wallbang.enabled = Flags.wallbang
	return true
end

