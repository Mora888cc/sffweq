	button(misc, "dump module map", function()
		HUD.push("modules:")
		for name, present in pairs(G.ok) do
			HUD.push((present and "+ " or "- ") .. name)
		end
	end)
	button(misc, "hook ammo members (" .. tostring(InfAmmo.hooked) .. ")", function()
		local n = InfAmmo.install()
		HUD.push("ammo hooks: " .. tostring(n))
	end)
	button(misc, "install wallbang hooks (" .. tostring(#Restores) .. " total)", function()
		Wallbang.install()
		HUD.push("restores: " .. tostring(#Restores))
	end)

	local cfg = UI.tab("config")
	section(cfg, "presets")
	button(cfg, "save config", function()
		local ok, err = saveConfig()
		HUD.push(ok and "config saved" or ("save failed: " .. tostring(err)))
	end)
	button(cfg, "load config", function()
		local ok, err = loadConfig()
		HUD.push(ok and "config loaded" or ("load failed: " .. tostring(err)))
	end)
	section(cfg, "runtime")
	button(cfg, "re-pick hit part", function()
		Flags.aimHitPart = Flags.aimHitPart == "Head" and "Torso" or "Head"
		HUD.push("hit part: " .. Flags.aimHitPart)
	end)
	button(cfg, "unload", function()
		if _G.__pena_toolkit then
			_G.__pena_toolkit.unload()
		end
	end)
end

--=============================================================
-- main loop
--=============================================================
local aliveFlag = true
local connections = {}
local renderBinding = nil

local function connect(signal, fn)
	connections[#connections + 1] = signal:Connect(fn)
end

local function unload()
	aliveFlag = false
	if renderBinding then
		pcall(function()
			RunService:UnbindFromRenderStep(renderBinding)
		end)
		renderBinding = nil
	end
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	connections = {}
	for _, restore in ipairs(Restores) do
		pcall(restore)
	end
	Restores = {}
	NoSpread.disable()
	if ESP.gui then
		pcall(function()
			ESP.gui:Destroy()
		end)
	end
	if UI.root then
		pcall(function()
			UI.root:Destroy()
		end)
	end
	_G.__pena_toolkit = nil
end

buildMenu()
ESP.init()
HUD.init()

local function renderStep()
	if not aliveFlag then
		return
	end
	-- camera writes happen at Camera priority + 50 so the game's controller
	-- has already run for this frame and we win the final say
	Aim.step()
	if Flags.antiaim and not Aim.wantsActive() then
		local camera = cam()
		if camera then
			local pos = camera.CFrame.Position
			local jittered = camera.CFrame * antiAimOffset()
			camera.CFrame = CFrame.lookAt(pos, pos + jittered.LookVector)
		end
	end
	ESP.step()
	HUD.step()
end

local bindName = "pena_toolkit_render"
local bound = pcall(function()
	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 50, renderStep)
end)
if bound then
	renderBinding = bindName
else
	connect(RunService.RenderStepped, renderStep)
end

connect(RunService.Heartbeat, function()
	if not aliveFlag then
		return
	end
	Move.step()
	Aim.trigger()
end)

connect(UserInput.InputBegan, function(input)
	if input.KeyCode == Enum.KeyCode.Insert then
		if UI.main then
			UI.main.Visible = not UI.main.Visible
		end
	end
end)

-- binds capture keyboard only; the mouse stays reserved for shooting
_G.__pena_toolkit = {
	flags = Flags,
	modules = G,
	targets = Targets,
	unload = unload,
	save = saveConfig,
	load = loadConfig,
}

HUD.push("toolkit ready - insert")
for name, present in pairs(G.ok) do
	if not present then
		HUD.push("missing module: " .. name)
	end
end
