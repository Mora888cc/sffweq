--=============================================================
-- character / target layer
--=============================================================
local Targets = {}

local HIT_PARTS = {
	Head = { "Head" },
	Torso = { "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" },
	Nearest = { "Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" },
}

local function rootOf(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	root = model.PrimaryPart
	if root then
		return root
	end
	return nil
end

local function alive(model)
	if not model or not model.Parent then
		return false
	end
	if model:GetAttribute("Dead") == true then
		return false
	end
	local hp = model:GetAttribute("Health")
	if type(hp) == "number" and hp <= 0 then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end
	return true
end

local function selfChar()
	local char = LocalPlayer.Character
	if char and char.Parent and rootOf(char) and alive(char) then
		return char
	end
	return nil
end

local function myTeam()
	local team = LocalPlayer:GetAttribute("Team")
	if team then
		return team
	end
	local char = selfChar()
	return char and char:GetAttribute("Team") or nil
end

local function isEnemy(team, plr)
	if plr == LocalPlayer then
		return false
	end
	if gamemode() == "Deathmatch" then
		return true
	end
	if not Flags.aimTeamCheck then
		return true
	end
	local mine = myTeam()
	if not mine or not team then
		return false
	end
	return team ~= mine
end

-- one pass over the character containers, indexed by CombatantId and UserId
local function indexCharacters()
	local byId, byUser = {}, {}
	for _, folderName in ipairs({ "Characters", "_PVS_CulledCharacters" }) do
		local folder = Workspace:FindFirstChild(folderName)
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:IsA("Model") then
					local id = model:GetAttribute("CombatantId")
					if id ~= nil then
						byId[id] = model
					end
					local uid = model:GetAttribute("UserId")
					if uid ~= nil then
						byUser[uid] = model
					end
				end
			end
		end
	end
	return byId, byUser
end

function Targets.list()
	local out = {}
	local seen = {}
	local byId, byUser = indexCharacters()

	local holders = Replicated:FindFirstChild("Combatants") or Workspace:FindFirstChild("Combatants")
	if holders then
		for _, holder in ipairs(holders:GetChildren()) do
			local id = holder:GetAttribute("CombatantId")
			local model = id ~= nil and byId[id] or nil
			if not model then
				local uid = holder:GetAttribute("UserId")
				model = uid ~= nil and byUser[uid] or nil
			end
			if model and not seen[model] and alive(model) then
				local team = model:GetAttribute("Team") or holder:GetAttribute("Team")
				local uid = model:GetAttribute("UserId") or holder:GetAttribute("UserId")
				local plr = uid and Players:GetPlayerByUserId(tonumber(uid) or -1) or nil
				if isEnemy(team, plr) then
					seen[model] = true
					local label = holder:GetAttribute("DisplayName")
						or model:GetAttribute("DisplayName")
						or (plr and plr.Name)
						or model.Name
					out[#out + 1] = { model = model, plr = plr, name = tostring(label) }
				end
			end
		end
	end

	-- standard players, for lobbies that still parent characters under the player
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char and not seen[char] and alive(char) and isEnemy(char:GetAttribute("Team") or plr:GetAttribute("Team"), plr) then
			seen[char] = true
			out[#out + 1] = { model = char, plr = plr, name = plr.Name }
		end
	end
	return out
end

local function hitPart(model, mode)
	local list = HIT_PARTS[mode] or HIT_PARTS.Head
	for _, name in ipairs(list) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return rootOf(model)
end

local function velocityOf(model, part)
	if type(G.charVel) == "function" then
		local v = try(G.charVel, model)
		if typeof(v) == "Vector3" then
			return v
		end
	end
	if part then
		return part.AssemblyLinearVelocity
	end
	return Vector3.zero
end

local function characterParts()
	local set = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char then
			set[#set + 1] = char
		end
	end
	for _, name in ipairs({ "Characters", "_PVS_CulledCharacters", "Debris" }) do
		local f = Workspace:FindFirstChild(name)
		if f then
			set[#set + 1] = f
		end
	end
	if Debris then
		set[#set + 1] = Debris
	end
	return set
end

local function lineOfSight(part, targetModel)
	if not Flags.aimVisible then
		return true
	end
	local filter = {}
	for _, inst in ipairs(characterParts()) do
		if inst ~= targetModel then
			filter[#filter + 1] = inst
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true
	local camera = cam()
	if not camera then
		return true
	end
	local origin = camera.CFrame.Position
	local hit = Workspace:Raycast(origin, part.Position - origin, params)
	if not hit then
		return true
	end
	return hit.Instance and hit.Instance:IsDescendantOf(targetModel)
end

