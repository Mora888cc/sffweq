local Restores = {}

local function addRestore(fn)
	Restores[#Restores + 1] = fn
end

--=============================================================
-- nospread : zero the random() bias the spread cone is built from
--=============================================================
local NoSpread = { enabled = false, orig = nil }

function NoSpread.enable()
	if NoSpread.enabled then
		return true
	end
	if type(hookfn) ~= "function" then
		return false
	end
	local ok, orig = pcall(hookfn, math.random, function(a, b, c)
		if NoSpread.enabled then
			if a == nil then
				return 0.5
			elseif b == nil then
				return 1
			else
				return math.floor((a + b) / 2 + 0.5)
			end
		end
		if NoSpread.orig then
			return NoSpread.orig(a, b, c)
		end
		return 0
	end)
	if not ok or type(orig) ~= "function" then
		return false
	end
	NoSpread.orig = orig
	NoSpread.enabled = true
	addRestore(function()
		NoSpread.enabled = false
		pcall(hookfn, math.random, orig)
	end)
	return true
end

function NoSpread.disable()
	NoSpread.enabled = false
end

--=============================================================
-- infinite ammo : wrap ammo-ish members of the inventory/weapon modules
--=============================================================
local InfAmmo = { enabled = false, installed = false, hooked = 0 }

local AMMO_PATTERN = "ammo"

local function ammoFactory(name, orig)
	return function(...)
		local r = orig(...)
		if not InfAmmo.enabled then
			return r
		end
		if type(r) == "number" then
			return math.huge
		end
		return r
	end
end

function InfAmmo.install()
	if type(hookfn) ~= "function" then
		return 0
	end
	if InfAmmo.installed then
		return InfAmmo.hooked
	end
	InfAmmo.installed = true
	local total = 0
	for _, mod in ipairs({ G.inventory, G.weapon, G.bullet }) do
		if type(mod) == "table" then
			for key, value in pairs(mod) do
				if type(value) == "function" and type(key) == "string" and key:lower():find(AMMO_PATTERN) then
					local ok, orig = pcall(hookfn, value, ammoFactory(key, value))
					if ok and type(orig) == "function" then
						total += 1
						addRestore(function()
							pcall(hookfn, value, orig)
						end)
					end
				end
			end
		end
	end
	InfAmmo.hooked = total
	return total
end

--=============================================================
-- wallbang : bullet rays ignore non-character geometry
--=============================================================
local Wallbang = { enabled = false, installed = false, hooked = 0 }

local function isCharacterInstance(inst)
	local model = inst:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function wallbangFactory(name, orig)
	return function(...)
		local r = orig(...)
		if not Wallbang.enabled then
			return r
		end
		if typeof(r) == "RaycastResult" then
			local inst = r.Instance
			if inst and not isCharacterInstance(inst) then
				return nil
			end
		end
		return r
	end
end

function Wallbang.install()
	if type(hookfn) ~= "function" then
		return 0
	end
	if Wallbang.installed then
		return Wallbang.hooked
	end
	Wallbang.installed = true
	local total = 0
	for _, mod in ipairs({ G.raycast, G.bullet, G.weapon }) do
		if type(mod) == "table" then
			for key, value in pairs(mod) do
				if type(value) == "function" then
					local ok, orig = pcall(hookfn, value, wallbangFactory(key, value))
					if ok and type(orig) == "function" then
						total += 1
						addRestore(function()
							pcall(hookfn, value, orig)
						end)
					end
				end
			end
		end
	end
	Wallbang.hooked = total
	return total
end

