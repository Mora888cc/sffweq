local G = {
	ok = {},
}

local function waitPath(...)
	local node = Replicated
	for i = 1, select("#", ...) do
		local name = select(i, ...)
		local child = try(function()
			return node:WaitForChild(name, 4)
		end)
		if not child then
			return nil
		end
		node = child
	end
	return node
end

local function loadModule(...)
	local inst = waitPath(...)
	if not inst or not inst:IsA("ModuleScript") then
		return nil
	end
	local res = try(require, inst)
	if res == nil then
		return nil
	end
	return res
end

local function probe(name, fn)
	local v = try(fn)
	G[name] = v
	G.ok[name] = v ~= nil
	return v
end

