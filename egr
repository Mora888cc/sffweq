local function try(fn, ...)
	local ok, a, b = pcall(fn, ...)
	if ok then
		return a, b
	end
	return nil
end

local clamp = math.clamp or function(v, a, b)
	if v < a then return a end
	if v > b then return b end
	return v
end

local function round(v)
	return math.floor(v + 0.5)
end

