		Parent = row,
	}, row)
	corner(btn, 4)
	stroke(btn, Theme.faint, 0.5, 1)
	local capturing = false
	local function render()
		btn.Text = Flags[flag] or "none"
	end
	btn.MouseButton1Click:Connect(function()
		capturing = true
		btn.Text = "..."
	end)
	UserInput.InputBegan:Connect(function(input)
		if not capturing then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		capturing = false
		local key = input.KeyCode.Name
		if key == "Escape" or key == "Backspace" or key == "Unknown" then
			Flags[flag] = nil
		else
			Flags[flag] = key
		end
		render()
	end)
	UI.controls[flag] = { render = render, kind = "bind" }
	return row
end

