--=============================================================
-- aimbot / triggerbot
--=============================================================
local Aim = {
	current = nil,
	lastShot = 0,
	spread = 0,
}

local function viewportCenter()
	local camera = cam()
	if not camera then
		return Vector2.zero
	end
	local size = camera.ViewportSize
	return Vector2.new(size.X / 2, size.Y / 2)
end

function Aim.wantsActive()
	if not Flags.aim then
		return false
	end
	if Flags.aimKey and not keyHeld[Flags.aimKey] then
		return false
	end
	local char = selfChar()
	if not char or not alive(char) then
		return false
	end
	if inBuyPeriod() then
		return false
	end
	return true
end

function Aim.pick()
	local camera = cam()
	if not camera then
		return nil
	end
	local center = viewportCenter()
	local best, bestDist = nil, math.huge
	for _, t in ipairs(Targets.list()) do
		local part = hitPart(t.model, Flags.aimHitPart)
		if part then
			local sp, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen then
				local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
				if d <= Flags.aimFov and d < bestDist then
					if lineOfSight(part, t.model) then
						best, bestDist = { target = t, part = part, dist = d }, d
					end
				end
			end
		end
	end
	return best
end

function Aim.step()
	local camera = cam()
	if not camera then
		return
	end
	local pick = Aim.wantsActive() and Aim.pick() or nil
	Aim.current = pick
	if not pick then
		return
	end
	local part = pick.part
	local aimPos = part.Position
	local pred = Flags.aimPrediction
	if pred > 0 then
		aimPos = aimPos + velocityOf(pick.target.model, part) * pred
	end
	local origin = camera.CFrame.Position
	local desired = CFrame.lookAt(origin, aimPos)
	local smooth = Flags.aimSmooth
	if smooth <= 1 then
		camera.CFrame = desired
	else
		local alpha = clamp(1 / (smooth * 0.55), 0.02, 1)
		camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	end
end

local lastTrigger = 0

function Aim.trigger()
	if not Flags.trigger then
		return
	end
	if UserInput:GetFocusedTextBox() then
		return
	end
	local now = os.clock()
	if now - lastTrigger < Flags.triggerDelay then
		return
	end
	local char = selfChar()
	if not char or not alive(char) or inBuyPeriod() then
		return
	end
	local camera = cam()
	if not camera then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = characterParts()
	params.IgnoreWater = true
	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector * 500
	local hit = Workspace:Raycast(origin, dir, params)
	if not hit or not hit.Instance then
		return
	end
	if not isCharacterInstance(hit.Instance) then
		return
	end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	if not model or not alive(model) then
		return
	end
	local sp = camera:WorldToViewportPoint(hit.Position)
	if typeof(sp) ~= "Vector3" then
		return
	end
	local d = (Vector2.new(sp.X, sp.Y) - viewportCenter()).Magnitude
	if d > Flags.triggerFov then
		return
	end
	lastTrigger = now
	clicked()
end

--=============================================================
-- movement
--=============================================================
local Move = { original = nil }

function Move.step()
	local char = selfChar()
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if Flags.bhop then
		if UserInput:IsKeyDown(Enum.KeyCode.Space) and hum.FloorMaterial ~= Enum.Material.Air then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
	if Flags.speed then
		if Move.original == nil then
			Move.original = hum.WalkSpeed
		end
		if hum.WalkSpeed ~= Flags.speedValue then
			hum.WalkSpeed = Flags.speedValue
		end
	elseif Move.original then
		if hum.WalkSpeed == Flags.speedValue then
			hum.WalkSpeed = Move.original
		end
		Move.original = nil
	end
end

-- anti-aim: yaw/pitch offset applied to the reported camera basis
local function antiAimOffset()
	if not Flags.antiaim then
		return CFrame.new()
	end
	local t = os.clock()
	local yaw = math.rad(Flags.aaYaw) * math.sin(t * 17)
	local pitch = math.rad(Flags.aaPitch) * math.cos(t * 13)
	return CFrame.Angles(pitch, yaw, 0)
end

