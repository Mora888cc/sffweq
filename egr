local function slider(page, label, flag, min, max, step, suffix)
	local row = rowFrame(page, 40)
	corner(row, 6)

	local text = mk("TextLabel", {
		Position = UDim2.fromOffset(10, 3),
		Size = UDim2.new(1, -70, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		Text = label,
		TextColor3 = Theme.txt,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	}, row)

	local value = mk("TextLabel", {
		Position = UDim2.new(1, -70, 0, 3),
		Size = UDim2.fromOffset(60, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		Text = tostring(Flags[flag]),
		TextColor3 = Theme.acc,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	}, row)

	local track = mk("Frame", {
		Position = UDim2.new(0, 10, 0, 26),
		Size = UDim2.new(1, -20, 0, 4),
		BackgroundColor3 = Theme.bg,
		Parent = row,
	}, row)
	corner(track, 2)

	local fill = mk("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.acc,
		Parent = track,
	}, track)
	corner(fill, 2)

	local dragging = false

	local function render()
		local v = tonumber(Flags[flag]) or min
		local frac = clamp((v - min) / (max - min == 0 and 1 or max - min), 0, 1)
		fill.Size = UDim2.fromScale(frac, 1)
		value.Text = tostring(v) .. (suffix or "")
	end

	local function apply(px)
		local box = track.AbsoluteSize.X
		if box <= 0 then
			return
		end
		local frac = clamp(px / box, 0, 1)
		local raw = min + frac * (max - min)
		if step and step > 0 then
			raw = math.floor(raw / step + 0.5) * step
		end
		Flags[flag] = clamp(raw, min, max)
		render()
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			apply(input.Position.X - track.AbsolutePosition.X)
		end
	end)
	UserInput.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			apply(input.Position.X - track.AbsolutePosition.X)
		end
	end)
	UserInput.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	render()
	UI.controls[flag] = { render = render, kind = "slider" }
	return row
end

