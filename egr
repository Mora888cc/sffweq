local ESP = {
	enabled = false,
	gui = nil,
	entries = setmetatable({}, { __mode = "k" }),
	active = {},
}

local function parentGui(gui)
	local ok = pcall(function()
		gui.Parent = CoreGui
	end)
	if not ok or not gui.Parent then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then
			pcall(function()
				gui.Parent = pg
			end)
		end
	end
end

function ESP.init()
	if ESP.gui then
		return ESP.gui
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "PenaToolkit"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	parentGui(gui)
	ESP.gui = gui
	return gui
end

local function makeEntry()
	local gui = ESP.init()
	local box = Instance.new("Frame")
	box.Name = "box"
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(200, 148, 232)
	stroke.Thickness = 1
	stroke.Transparency = 0.15
	stroke.Parent = box

	local fill = Instance.new("Frame")
	fill.Name = "health"
	fill.BackgroundColor3 = Color3.fromRGB(128, 214, 156)
	fill.BorderSizePixel = 0
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Parent = box

	local name = Instance.new("TextLabel")
	name.Name = "name"
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamMedium
	name.TextSize = 12
	name.TextColor3 = Color3.fromRGB(235, 235, 240)
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Parent = gui

	local dist = Instance.new("TextLabel")
	dist.Name = "dist"
	dist.BackgroundTransparency = 1
	dist.Font = Enum.Font.Gotham
	dist.TextSize = 11
	dist.TextColor3 = Color3.fromRGB(170, 170, 178)
	dist.TextXAlignment = Enum.TextXAlignment.Left
	dist.Parent = gui

	return { box = box, stroke = stroke, fill = fill, name = name, dist = dist }
end

local function entryFor(model)
	local e = ESP.entries[model]
	if not e then
		e = makeEntry()
		ESP.entries[model] = e
	end
	return e
end

function ESP.hide(entry)
	if entry.box.Parent then
		entry.box.Visible = false
	end
	entry.name.Visible = false
	entry.dist.Visible = false
end

function ESP.step()
	if not ESP.gui then
		return
	end
	local camera = cam()
	if not camera then
		return
	end
	local alive_set = {}
	if Flags.esp then
		local camPos = camera.CFrame.Position
		for _, t in ipairs(Targets.list()) do
			local model = t.model
			local root = rootOf(model)
			local head = model:FindFirstChild("Head")
			if root and head then
				local dist = (root.Position - camPos).Magnitude
				if dist <= Flags.espMaxDist then
					local e = entryFor(model)
					local top, topOn = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
					local bottom, botOn = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.9, 0))
					if topOn and botOn then
						local height = math.abs(bottom.Y - top.Y)
						local width = height * 0.52
						if height > 4 and height < 2000 then
							alive_set[model] = true
							e.box.Visible = Flags.espBox
							e.box.Position = UDim2.fromOffset(top.X - width / 2, top.Y)
							e.box.Size = UDim2.fromOffset(width, height)
							e.name.Visible = Flags.espName
							e.name.Text = t.name
							e.name.Position = UDim2.fromOffset(top.X - width / 2, top.Y - 16)
							e.dist.Visible = Flags.espDistance
							e.dist.Text = string.format("%dm", round(dist / 3))
							e.dist.Position = UDim2.fromOffset(top.X - width / 2, top.Y + height + 2)
							if Flags.espHealth then
								local hp = model:GetAttribute("Health")
								if type(hp) ~= "number" then
									local hum = model:FindFirstChildOfClass("Humanoid")
									hp = hum and hum.Health or 100
								end
								local frac = clamp(hp / 100, 0, 1)
								e.fill.Visible = true
								e.fill.Size = UDim2.new(0, 2, frac, 0)
								e.fill.BackgroundColor3 = Color3.fromRGB(
									round(112 + (255 - 112) * (1 - frac)),
									round(214 + (112 - 214) * (1 - frac)),
									round(156 + (118 - 156) * (1 - frac))
								)
							else
								e.fill.Visible = false
							end
						else
							ESP.hide(e)
						end
					else
						ESP.hide(e)
					end
				elseif ESP.entries[model] then
					ESP.hide(ESP.entries[model])
				end
			end
		end
	end
	for model, e in pairs(ESP.entries) do
		if not alive_set[model] then
			ESP.hide(e)
		end
		if not model.Parent then
			e.box:Destroy()
			e.name:Destroy()
			e.dist:Destroy()
			ESP.entries[model] = nil
		end
	end
end

