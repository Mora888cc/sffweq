function HUD.push(text)
	table.insert(HUD.lines, 1, text)
	while #HUD.lines > 4 do
		table.remove(HUD.lines)
	end
	if HUD.log then
		HUD.log.Text = table.concat(HUD.lines, "\n")
	end
end

function HUD.step()
	if not HUD.ring then
		return
	end
	local show = Flags.showFov
	HUD.ring.Visible = show
	if show then
		local d = Flags.aimFov * 2
		HUD.ring.Size = UDim2.fromOffset(d, d)
		HUD.ring.Position = UDim2.fromScale(0.5, 0.5)
	end
	if HUD.log then
		HUD.log.Visible = Flags.showLogs
	end
end

